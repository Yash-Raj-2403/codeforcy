#include<bits/stdc++.h>using namespace std; int main(){    int t;    cin >> t;    while(t--)    {        string s;        cin >> s;        int n = s.size();        if(n%2!=0)        {            cout << "NO" << endl;        }        else        {            int fehalf = n/2;            int sehalf = n/2;            string shalf(sehalf , ' ');            string fhalf(fehalf, ' ');            for(int i=0;i<fehalf;i++)            {                fhalf[i] = s[i];            }            for(int i=0;i<sehalf;i++)            {                shalf[i] = s[i+sehalf];            }            bool tutgya = true;            for(int i=0;i<fehalf;i++)            {                if(shalf[i] != fhalf[i])                {                    tutgya = false;                    break;                }            }            if(tutgya)            {                cout << "YES" << endl;            }            else            {                cout << "NO" << endl;            }        }    }}